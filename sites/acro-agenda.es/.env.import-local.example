# Copy this file to ../../.env.import-local/acro-agenda.es and fill in the SSH details.
# Do not commit the resulting file.
PRODUCTION_SSH=hosting-user@example-host
PRODUCTION_SSH_PORT=65002
PRODUCTION_WP_PATH=/home/hosting-user/domains/acro-agenda.es/public_html

# Optional connection and URL overrides.
# PRODUCTION_SSH_KEY=/absolute/path/to/private-key
# PRODUCTION_URL=https://acro-agenda.es
# LOCAL_URL=http://localhost:9788

# Optional local-only administrator overrides.
# LOCAL_ADMIN_USER=admin
# LOCAL_ADMIN_EMAIL=admin@localhost.test
# LOCAL_ADMIN_PASSWORD=password

# Optional Fair plugin release and GitHub API overrides.
# FAIR_PLUGIN_RELEASE=build-1.17.0-9-gfefc8678
# GITHUB_TOKEN=github-token
