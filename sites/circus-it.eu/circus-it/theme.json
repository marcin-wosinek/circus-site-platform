{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "name": "Canvas", "slug": "canvas", "color": "#ffffff" },
        { "name": "Ink", "slug": "ink", "color": "#111111" },
        { "name": "Muted", "slug": "muted", "color": "#666666" },
        { "name": "Rule", "slug": "rule", "color": "#d8d8d8" },
        { "name": "Signal", "slug": "signal", "color": "#1f4fff" }
      ]
    },
    "layout": {
      "contentSize": "44rem",
      "wideSize": "76rem"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "vw", "vh"],
      "spacingSizes": [
        { "name": "Small", "slug": "small", "size": "0.75rem" },
        { "name": "Medium", "slug": "medium", "size": "1.5rem" },
        { "name": "Large", "slug": "large", "size": "3rem" },
        { "name": "Extra large", "slug": "x-large", "size": "clamp(4rem, 10vw, 8rem)" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Sans",
          "slug": "sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif"
        },
        {
          "name": "Utility",
          "slug": "utility",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        { "name": "Small", "slug": "small", "size": "0.8125rem" },
        { "name": "Body", "slug": "body", "size": "1rem" },
        { "name": "Lead", "slug": "lead", "size": "clamp(1.125rem, 2vw, 1.375rem)" },
        { "name": "Display", "slug": "display", "size": "clamp(2.75rem, 8vw, 6.75rem)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--medium)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.55"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "600",
          "letterSpacing": "-0.045em",
          "lineHeight": "0.95"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--ink)" },
        "typography": {
          "textDecoration": "underline",
          "textUnderlineOffset": "0.2em"
        },
        ":hover": { "color": { "text": "var(--wp--preset--color--signal)" } }
      },
      "h1": {
        "typography": { "fontSize": "var(--wp--preset--font-size--display)" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
